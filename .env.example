# Configuración pública de la aplicación web Firebase (Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Solo servidor: nunca agregar prefijo VITE_ a estas variables.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Clave completa de la cuenta de servicio. Conservar BEGIN/END y los saltos \n.
FIREBASE_PRIVATE_KEY=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
